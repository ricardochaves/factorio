# --- local only -------------------------------------------------------------
# Superseded files (original books, older refinery versions, raw screenshots).
/archive/
.DS_Store
# Local secrets, never committed.
.env
.env.*
# Files that can hold an account token or a browser session, wherever a tool leaves them (Factorio's player-data.json,
# recorded HTTP traffic, Playwright storage state and auth folders, and the Playwright MCP output folder).
player-data.json
*.har
*.har.gz
*storage-state*.json
**/playwright/.auth/
.playwright-mcp/
# Private keys and certificates.
*.pem
*.key

# Claude Code: keep only the project instructions and the shared subagents and commands (Markdown files only). A project
# settings.json or a hook script under .claude/ would need its own `!` line here.
/.claude/*
!/.claude/CLAUDE.md
!/.claude/agents/
/.claude/agents/*
!/.claude/agents/*.md
!/.claude/commands/
/.claude/commands/*
!/.claude/commands/*.md
# Personal notes for Claude Code that stay on this machine.
CLAUDE.local.md

# --- Python / C build output ---------------------------------------------------
__pycache__/
*.pyc
*.so
*.pkl

# --- tool output -----------------------------------------------------------------
*.log
/scripts/*.json
/scripts/ingame_analysis*.txt
/scripts/lib_*.txt

# Third-party inputs (fetch them as described in scripts/README.md).
/scripts/sources/
/scripts/xcheck/venv/
/scripts/xcheck/factorio_balancers/

# --- Factorio headless harness -----------------------------------------------------
# Generated on every run (holds an absolute path).
/scripts/ingame/config.ini
# The write-data dir holds player-data.json (Factorio account token), saves, logs and results.
# Only the hand-written scenario code is tracked.
/scripts/ingame/data/*
!/scripts/ingame/data/scenarios/
# Generated test data inside the scenarios.
/scripts/ingame/data/scenarios/balancer-test/tests*.lua
/scripts/ingame/data/scenarios/balancer-test/tier.lua
/scripts/ingame/data/scenarios/fluid-test/tests*.lua
/scripts/ingame/data/scenarios/fluid-test/tests*.json
/scripts/ingame/data/scenarios/fluid-shot/bp.lua
/scripts/ingame/data/scenarios/blueprint-shot/bp.lua
/scripts/ingame/data/scenarios/balancer-shot/shots.lua
/scripts/ingame/data/scenarios/iron-copper-shot/bp.lua
/scripts/ingame/data/scenarios/site-import/strings.lua
/scripts/ingame/data/scenarios/city-test/strings.lua
/scripts/ingame/data/scenarios/city-shot/strings.lua
/scripts/ingame/data/scenarios/smelter-test/strings.lua
/scripts/ingame/data/scenarios/bookimport/book.lua
# The game keeps mod-settings.dat (and any mod zip) in the mod directory; only the vanilla mod list is tracked.
/scripts/ingame/mods/*
!/scripts/ingame/mods/mod-list.json

# --- site build output ------------------------------------------------------------
# Catalog index (scripts/catalog/validate.py --json build/catalog.json), the site (site/build.py -> build/site/)
# and its cache of resized images and split strings (build/.cache/).
/build/
# Virtual environment for the site generator (python3 -m venv .venv).
/.venv/
# Snapshots written by playwright-cli while testing the site.
.playwright-cli/
# Saved login state at the path Playwright documents for it (it holds cookies).
playwright/.auth/
